+export function preparePrefixedDataPath(prefixedParts, separator, dataParts, loc) {
+  loc = this.locInfo(loc);
+
+  let original = '';
+  let depth = 0;
+
+  for (let i = 0, l = prefixedParts.length; i < l; i++) {
+    let part = prefixedParts[i].part;
+    // If we have [] syntax then we do not treat path references as operators,
+    // i.e. foo.[..] resolves to approximately context.foo['..']
+    let isLiteral = prefixedParts[i].original !== part;
+    let partSeparator = prefixedParts[i].separator;
+
+    if (!isLiteral && part !== '..' && part !== '.') {
+      throw new Exception('Invalid path: ' + part, { loc });
+    }
+
+    original += (partSeparator || '') + part;
+
+    if (!isLiteral && part === '..') {
+      depth++;
+    }
+  }
+
+  let dataPath = preparePath.call(this, true, false, dataParts, loc);
+
+  return {
+    type: 'PathExpression',
+    this: false,
+    data: true,
+    depth: depth + dataPath.depth,
+    head: dataPath.head,
+    tail: dataPath.tail,
+    parts: dataPath.parts,
+    original: original + separator + '@' + dataPath.original.slice(1),
+    loc,
+  };
+}
